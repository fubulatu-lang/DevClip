    <!-- Setup. Each body says what the permission buys the user, not what the
         permission is called, and why Android will look alarmed about it. -->
    <string name="setup_heading">Set up DevClip</string>
    <string name="setup_sub">Five steps, in this order, and DevClip works from anywhere on your phone. You can skip and come back to them later.</string>
    <string name="setup_restricted">Allow restricted settings</string>
    <string name="setup_restricted_body">Android greys out the next step for apps installed outside the Play Store. In App info, open the menu at the top right and choose Allow restricted settings. Skip this if step 2 is not greyed out.</string>
    <string name="setup_open">Open</string>
    <string name="setup_battery">Unrestricted battery</string>
    <string name="setup_battery_body">Stops Android putting DevClip to sleep. Asleep, it is unplugged from text capture while the switch still reads as on, which looks exactly like the feature being broken.</string>
    <string name="setup_capture">Text capture</string>
    <string name="setup_capture_body">Lets DevClip read the text you have highlighted, so tapping the bubble saves it. Android shows a broad warning for this — it is what makes capture possible at all.</string>
    <string name="setup_bubble">Floating bubble</string>
    <string name="setup_bubble_body">Lets DevClip draw its bubble over other apps. Without it there is no bubble, and DevClip is a list you have to open.</string>
    <string name="setup_notifications">Notifications</string>
    <string name="setup_notifications_body">One quiet, ongoing notification while the bubble runs. It is also how you bring the bubble back after hiding it.</string>
    <string name="setup_enable">Enable</string>
